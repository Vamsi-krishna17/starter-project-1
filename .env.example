AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=
# Starter Project 2: only the deployment name differs from the chat model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Local runs (python on your machine, Postgres in Docker on the mapped port)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders
LEAD_TIME_DAYS=3
LOG_LEVEL=INFO

# Optional tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_COMPLETION_TOKENS=2000
MAX_EMAIL_CHARS=8000
# Official guide: deadline is optional. Set true only if you want a missing deadline to give Need info.
REQUIRE_DEADLINE=false

# Starter Project 2: RAG
RAG_TOP_K=5                  # chunks retrieved for the reply
RAG_RESOLVE_TOP_K=10         # chunks retrieved to resolve a product description

# Starter Project 2: pricing rules (from docs/pricing_policy.md)
QUOTE_DISCOUNT_TIERS=1:0,10:5,50:8,200:12   # min_quantity:discount_percent
QUOTE_FREE_DELIVERY_THRESHOLD_INR=50000
QUOTE_DELIVERY_CHARGE_INR=1500
QUOTE_VALIDITY_DAYS=7

# LangSmith tracing of the two LLM calls (optional - the app runs fine without it)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=email-to-order-starter-project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# false (default): traces carry only metadata/counts. true: also sends the email text with
# emails/phones/keys masked (names and addresses can NOT be masked reliably).
LANGSMITH_TRACE_CONTENT=false
